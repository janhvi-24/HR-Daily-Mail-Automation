{
  "name": "hr-mail-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Daily work-log sheet -> AI -> HR email, on Vercel",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "local": "tsx --env-file=.env scripts/local.ts",
    "setup": "tsx scripts/setup-env.ts",
    "push-env": "tsx scripts/push-env.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
