# Global settings only. Mail accounts, HR recipients, sheets and working days
# are added in the dashboard (stored in the database, passwords encrypted).

# ---------- General ----------
APP_TIMEZONE=Asia/Kolkata

# ---------- AI (Google Gemini) ----------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------- Google Sheets (read access) ----------
# Service-account key file contents: raw JSON on one line, or base64 of the file.
# Each person shares their sheet with this service account's client_email (Viewer).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- "Sign in with Google / Microsoft" (optional) ----------
# Needed only for the Gmail / Outlook sign-in buttons. Hostinger, Zoho, etc. work without these.
# Redirect URI to register with both: https://<your-app>.vercel.app/api/oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Public URL of the app; set it if you use a custom domain (defaults to the request's origin).
APP_URL=

# ---------- Storage ----------
# Neon Postgres connection string (set automatically by the Vercel Neon integration)
DATABASE_URL=

# ---------- Security ----------
# Encrypts stored mailbox passwords and sign-in tokens. Random, e.g. `openssl rand -hex 32`. Changing it
# means reconnecting every mailbox, so keep it safe.
ENCRYPTION_KEY=
# Protects /api/cron; Vercel Cron sends it automatically. `openssl rand -hex 32`
CRON_SECRET=
# Dashboard password; use a long passphrase.
ADMIN_PASSWORD=
